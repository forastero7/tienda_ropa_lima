# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

DATABASE_URL="postgresql://usuario:clave@localhost:5432/tienda_dev"

# URL pública del sitio (canonical, sitemap, enlaces de confirmación)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Tienda Lima"

# Sesiones del panel: cadena aleatoria de 32+ caracteres (openssl rand -base64 48)
ADMIN_SESSION_SECRET=""

# Protege /api/cron/* (caducidad de pedidos). Se envía como "Authorization: Bearer <valor>"
CRON_SECRET=""

# Minutos de reserva de stock por tipo de método
RESERVATION_MINUTES_ONLINE=30
RESERVATION_MINUTES_MANUAL=1440

# Plazo de respuesta del Libro de Reclamaciones en días hábiles (validar normativa vigente)
COMPLAINT_RESPONSE_BUSINESS_DAYS=15

# Métodos manuales: déjalos vacíos para deshabilitarlos
BANK_TRANSFER_INSTRUCTIONS=""
YAPE_PLIN_PHONE=""
YAPE_PLIN_HOLDER=""

# Pasarela de prueba local. Solo funciona fuera de producción.
PAYMENTS_SANDBOX_ENABLED="true"
PAYMENTS_SANDBOX_SECRET="cambia-esto-en-local"

# Datos del proveedor (identificación obligatoria en el sitio)
NEXT_PUBLIC_LEGAL_NAME="Razón social S.A.C."
NEXT_PUBLIC_RUC="20000000000"
NEXT_PUBLIC_LEGAL_ADDRESS="Dirección fiscal, Lima"
NEXT_PUBLIC_SUPPORT_EMAIL="hola@ejemplo.pe"
NEXT_PUBLIC_WHATSAPP="51900000000"

# Analítica (se carga solo con consentimiento)
NEXT_PUBLIC_GA_ID=""
